SAFEPLC_MODE=FULL
SAFEPLC_CHROMA_DIR=/path/to/s7_chroma_db_v3_tables
SAFEPLC_TEXT_COLLECTION=
SAFEPLC_FIGURE_CHROMA_DIR=/path/to/s7_multimodal_v1/index/chroma_figures_v1
SAFEPLC_FIGURE_COLLECTION=
SAFEPLC_CHUNKS_JSONL=/path/to/s7_full_chunks.jsonl
SAFEPLC_PAGES_JSONL=/path/to/s7_full_pages.jsonl
SAFEPLC_FIGURE_CARDS_JSONL=/path/to/s7_multimodal_v1/figure_cards/figure_cards_v1_final.jsonl
SAFEPLC_FIGURE_CHUNKS_JSONL=/path/to/s7_multimodal_v1/chunks/s7_figure_chunks_v1.jsonl
SAFEPLC_VISUAL_DIR=/path/to/s7_multimodal_v1/images/visual_candidate_pages
SAFEPLC_REPORT_DIR=reports
SAFEPLC_ROUTING_STRATEGY=adaptive
SAFEPLC_MAX_AGENTS=4
SAFEPLC_AGENT_TIMEOUT=30
SAFEPLC_ALLOW_JSONL_FALLBACK=1
SAFEPLC_REQUIRE_FIGURE_BACKEND=0
