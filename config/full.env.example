SAFEPLC_MODE=FULL
SAFEPLC_CHROMA_DIR=/path/to/text_chroma
SAFEPLC_TEXT_COLLECTION=
SAFEPLC_FIGURE_CHROMA_DIR=/path/to/figure_chroma
SAFEPLC_FIGURE_COLLECTION=
SAFEPLC_CHUNKS_JSONL=/path/to/chunks.jsonl
SAFEPLC_PAGES_JSONL=/path/to/pages.jsonl
SAFEPLC_FIGURE_CARDS_JSONL=/path/to/figure_cards.jsonl
SAFEPLC_FIGURE_CHUNKS_JSONL=/path/to/figure_chunks.jsonl
SAFEPLC_VISUAL_DIR=/path/to/images

SAFEPLC_EMBEDDING_BACKEND=auto
SAFEPLC_EMBEDDING_MODEL_PATH=/path/to/local_embedding_model
SAFEPLC_EMBEDDING_DEVICE=cpu
SAFEPLC_EMBEDDING_NORMALIZE=1
SAFEPLC_EMBEDDING_QUERY_PREFIX=
SAFEPLC_ALLOW_CHROMA_DEFAULT_EMBEDDING=0
SAFEPLC_ALLOW_REMOTE_MODEL_DOWNLOAD=0

SAFEPLC_ALLOW_JSONL_FALLBACK=0
SAFEPLC_ENABLE_JSONL_HYBRID=0
SAFEPLC_JSONL_FALLBACK_MIN_SCORE=0.20
SAFEPLC_REQUIRE_FIGURE_BACKEND=0

SAFEPLC_ROUTING_STRATEGY=adaptive
SAFEPLC_MAX_AGENTS=4
SAFEPLC_AGENT_TIMEOUT=30
SAFEPLC_REPORT_DIR=/path/to/runtime_reports
